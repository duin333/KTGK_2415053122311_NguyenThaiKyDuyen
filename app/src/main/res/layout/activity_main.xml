<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <EditText android:id="@+id/edtTen_311" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Ten khoan chi"/>
    <EditText android:id="@+id/edtTien_311" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="So tien"/>
    <TextView android:id="@+id/edtGhi_311" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Ghi chu"/>
    <Button android:id="@+id/btnThem_311" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Them khoan chi"/>
    <Button android:id="@+id/btnXem_311" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Xem chi tiet khoan chi"/>
</LinearLayout>